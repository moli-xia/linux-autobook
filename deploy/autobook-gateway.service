[Unit]
Description=linux-autobook central Baidu download gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=autobook
Group=autobook
WorkingDirectory=/opt/autobook-linux
EnvironmentFile=/etc/linux-autobook/gateway.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/autobook-linux/.venv/bin/python /opt/autobook-linux/run_gateway.py
Restart=always
RestartSec=10
TimeoutStopSec=1800
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/autobook-linux/runtime

[Install]
WantedBy=multi-user.target
