[Unit]
Description=linux-autobook concurrent document-delivery worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=autobook
Group=autobook
WorkingDirectory=/opt/autobook-linux
EnvironmentFile=/etc/linux-autobook/worker.env
ExecStart=/opt/autobook-linux/.venv/bin/python /opt/autobook-linux/run_worker.py
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=20
TimeoutStopSec=1800
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/autobook-linux/runtime

[Install]
WantedBy=multi-user.target
