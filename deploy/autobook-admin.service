[Unit]
Description=linux-autobook web administration panel
Documentation=https://github.com/moli-xia/linux-autobook
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/autobook-linux
EnvironmentFile=/etc/linux-autobook/admin.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/autobook-linux/.venv/bin/python /opt/autobook-linux/run_admin.py
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20
# The panel installs packages, rewrites certificates and re-runs the installer
# on the operator's behalf, so the usual filesystem sandbox cannot be applied.
# Access is instead gated by TLS, a hashed password and per-request CSRF tokens.

[Install]
WantedBy=multi-user.target
