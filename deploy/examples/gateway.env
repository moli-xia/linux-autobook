# chmod 600 /etc/linux-autobook/gateway.env
BAIDU_GATEWAY_TOKEN=replace-with-at-least-32-random-bytes
BAIDU_AUTH_FILE=/opt/autobook-linux/runtime/baidu_credentials.json
BAIDU_GROUP_GID=498636198303058255
BAIDU_SAVE_DIR=/autobook_inbox
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8765
GATEWAY_TLS_CERT=/opt/autobook-linux/runtime/gateway.crt
GATEWAY_TLS_KEY=/opt/autobook-linux/runtime/gateway.key
GATEWAY_CONCURRENCY=3
GATEWAY_CACHE_TTL_SECONDS=3600
GATEWAY_JOB_ROOT=/opt/autobook-linux/runtime/gateway/jobs
