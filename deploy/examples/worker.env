# chmod 600 /etc/linux-autobook/worker.env
SITE_BASE_URL=https://544544.xyz
WORKER_TOKEN=replace-with-site-worker-token
WORKER_ID=replace-with-unique-host-name
WORKER_QUEUE=pdf
POLL_SECONDS=15
CONCURRENCY=3
LEASE_HEARTBEAT_SECONDS=60
BAIDU_GATEWAY_URL=https://gateway.example:8765
BAIDU_GATEWAY_TOKEN=replace-with-at-least-32-random-bytes
BAIDU_GATEWAY_CA_FILE=/opt/autobook-linux/runtime/gateway.crt
BAIDU_GATEWAY_TIMEOUT_SECONDS=7200
DRIVE_EMAIL=replace-with-cloudreve-account
DRIVE_PASSWORD=replace-with-cloudreve-password
DRIVE_BASE_URL=https://drive.example
DRIVE_TARGET_DIR=transfer
DRIVE_EXPIRE_DAYS=7
