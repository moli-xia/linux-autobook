# chmod 600 /etc/linux-autobook/admin.env
ADMIN_BIND=0.0.0.0
ADMIN_PORT=8766
ADMIN_TLS_CERT=/etc/linux-autobook/admin.crt
ADMIN_TLS_KEY=/etc/linux-autobook/admin.key
ADMIN_STATE_FILE=/etc/linux-autobook/admin-state.json
ADMIN_GATEWAY_ENV=/etc/linux-autobook/gateway.env
ADMIN_WORKER_ENV=/etc/linux-autobook/worker.env
ADMIN_SESSION_SECONDS=28800
ADMIN_PUBLIC_HOST=
