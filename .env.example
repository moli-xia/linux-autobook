# ===== 任务网站 =====
SITE_BASE_URL=https://544544.xyz
WORKER_TOKEN=
WORKER_ID=linux-worker-1
WORKER_QUEUE=pdf
POLL_SECONDS=15
# 并发任务数（同时下载/转换/上传的任务数）
CONCURRENCY=3
# Worker 每隔多少秒续租一次网站任务
LEASE_HEARTBEAT_SECONDS=60

# ===== 推荐：中心百度下载网关（普通 Worker）=====
# 设置后，Worker 完全不读取百度 Cookie；URL 必须为 HTTPS。
BAIDU_GATEWAY_URL=
BAIDU_GATEWAY_TOKEN=
# 网关自签名证书或私有 CA 证书，用于证书固定校验
BAIDU_GATEWAY_CA_FILE=runtime/gateway.crt
BAIDU_GATEWAY_TIMEOUT_SECONDS=7200
BAIDU_GATEWAY_POLL_SECONDS=3

# ===== 百度网盘（网页版 Cookie 登录态）=====
# 推荐首次运行：python run_worker.py --baidu-login
# 扫码结果默认安全保存到 runtime/baidu_credentials.json；下面三项可留空。
BAIDU_AUTH_FILE=runtime/baidu_credentials.json
BAIDU_QR_PATH=runtime/baidu-login-qr.png
BAIDU_QR_TIMEOUT_SECONDS=120
# 仅网络无法直连百度时设置，例如 socks5h://127.0.0.1:10808
BAIDU_PROXY=
# 也可手工提供 Cookie；显式环境变量优先于凭据文件。
BAIDU_BDUSS=
BAIDU_STOKEN=
BAIDU_BAIDUID=
# 目标群名（账号必须已在群内）或直接填 gid
BAIDU_GROUP_NAME=读秀12群
BAIDU_GROUP_GID=
# 转存到自己网盘的临时目录（会自动清理）
BAIDU_SAVE_DIR=/autobook_inbox
# 下载 UA（SVIP 全速关键）；一般保持默认
DOWNLOAD_UA=netdisk;P2SP;3.0.20.56;netdisk;7.36.0.6;PC;PC-Windows;10.0.22621;WindowsBaiduYunGuanJia
ARIA2_SPLIT=16
ARIA2_MAX_CONNECTION=16
DOWNLOAD_TIMEOUT_SECONDS=1800
# 仅遗留 --sync-index 诊断命令使用；正常任务不会递归同步
FULL_SYNC_MAX_PAGES=2000

# ===== 本地路径（相对项目根目录或绝对路径）=====
WORK_ROOT=runtime/work
DOWNLOAD_ROOT=runtime/downloads
INDEX_DB=runtime/library_index.sqlite3
# 私人密码字典不会进入 Git；首次安装可复制 password.example.txt
PASSWORD_DICT=password.txt
SEVEN_ZIP_BIN=7z
ARIA2C_BIN=aria2c

# ===== 结果网盘（Cloudreve, drive.netupdown.com）=====
DRIVE_EMAIL=
DRIVE_PASSWORD=
DRIVE_BASE_URL=https://drive.netupdown.com
DRIVE_POLICY_ID=
DRIVE_TARGET_DIR=transfer
DRIVE_EXPIRE_DAYS=7
DRIVE_REQUIRE_UPLOAD_DATE_VERIFY=1

# ===== PDG 转换 =====
PDG_DPI=200

# ===== 中心百度下载网关服务端 =====
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8765
GATEWAY_TLS_CERT=runtime/gateway.crt
GATEWAY_TLS_KEY=runtime/gateway.key
GATEWAY_CONCURRENCY=3
GATEWAY_CACHE_TTL_SECONDS=3600
GATEWAY_JOB_ROOT=runtime/gateway/jobs
