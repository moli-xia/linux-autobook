# 复制为项目根目录的 .env 后按需修改：cp docker/.env.example .env

# 镜像名。自建镜像时改成你自己的仓库地址。
AUTOBOOK_IMAGE=ghcr.io/moli-xia/linux-autobook:latest

# 本机角色：all（网关 + Worker，主服务器）/ gateway（仅网关）/ worker（仅 Worker）
AUTOBOOK_ROLE=all

# 必填：服务器公网 IP 或域名，会写进自签名证书并作为面板访问地址
AUTOBOOK_PUBLIC_HOST=

# 端口
ADMIN_PORT=8766
GATEWAY_PORT=8765
TZ=Asia/Shanghai

# 以下仅在首次创建配置时写入，之后请在面板里修改
AUTOBOOK_SITE_URL=https://544544.xyz
AUTOBOOK_WORKER_TOKEN=
AUTOBOOK_WORKER_ID=
AUTOBOOK_CONCURRENCY=2
AUTOBOOK_DRIVE_URL=https://drive.netupdown.com
AUTOBOOK_DRIVE_EMAIL=
AUTOBOOK_DRIVE_PASSWORD=

# 仅 worker 角色需要：中心网关地址、共享令牌和证书路径
AUTOBOOK_GATEWAY_URL=
AUTOBOOK_GATEWAY_TOKEN=
AUTOBOOK_GATEWAY_CA_FILE=

# 仅中心网关开启。Pdg2Pic Wine 镜像按 04H 请求临时运行，完成即删除。
AUTOBOOK_PDG_FALLBACK_ENABLED=0
AUTOBOOK_PDG_FALLBACK_IMAGE=autobook-pdg2pic-wine:local
# `docker volume ls` 中对应 /opt/autobook-linux/runtime 的具名卷。
AUTOBOOK_PDG_FALLBACK_RUNTIME_VOLUME=
